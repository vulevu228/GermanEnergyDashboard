table _Measures
	lineageTag: fda32a8e-c155-5d7d-8fd0-ca16d3134604

	measure 'Generation TWh' = DIVIDE(SUM('Generation'[GWh]), 1000)
		formatString: #,##0
		displayFolder: 1 Generation
		lineageTag: a71b7df9-b558-51a4-a28a-e0df1649d7d8

	measure 'Renewables TWh' = CALCULATE([Generation TWh], 'Generation'[Group] = "Renewables")
		formatString: #,##0
		displayFolder: 1 Generation
		lineageTag: 09e902d0-36a9-5cac-a41e-0f099c011a94

	measure 'Fossil TWh' = CALCULATE([Generation TWh], 'Generation'[Group] = "Fossil")
		formatString: #,##0
		displayFolder: 1 Generation
		lineageTag: 5518b8e7-329b-5acb-bdd4-79cde1a4fcb8

	measure 'Nuclear TWh' = CALCULATE([Generation TWh], 'Generation'[Group] = "Nuclear") + 0
		formatString: #,##0
		displayFolder: 1 Generation
		lineageTag: 7f004c66-4c91-5e10-88b0-4a2cf0c5930d

	measure 'Renewable Share' = DIVIDE([Renewables TWh], [Generation TWh])
		formatString: 0.0%
		displayFolder: 1 Generation
		lineageTag: 34a860e1-e202-5eb4-a239-2efd3f54833b

	measure 'Renewable Share Delta Text' =
			VAR S = MIN('Calendar'[Date])
			VAR E = MAX('Calendar'[Date])
			VAR F = CALCULATE([Renewable Share], FILTER(ALL('Calendar'), 'Calendar'[Date] >= S && 'Calendar'[Date] < S + 365))
			VAR L = CALCULATE([Renewable Share], FILTER(ALL('Calendar'), 'Calendar'[Date] > E - 365 && 'Calendar'[Date] <= E))
			RETURN IF(E - S < 700, "last 12 months: " & FORMAT(L, "0%") & "",
			    "first yr " & FORMAT(F, "0%") & "  →  last yr " & FORMAT(L, "0%") & "")
		displayFolder: 1 Generation
		lineageTag: 6417c495-b6eb-5716-9606-2e4439c2b339

	measure 'Nuclear Delta Text' =
			VAR S = MIN('Calendar'[Date])
			VAR E = MAX('Calendar'[Date])
			VAR F = CALCULATE([Nuclear TWh], FILTER(ALL('Calendar'), 'Calendar'[Date] >= S && 'Calendar'[Date] < S + 365))
			VAR L = CALCULATE([Nuclear TWh], FILTER(ALL('Calendar'), 'Calendar'[Date] > E - 365 && 'Calendar'[Date] <= E))
			RETURN IF(E - S < 700, "last 12 months: " & FORMAT(L, "0") & "",
			    "first yr " & FORMAT(F, "0") & "  →  last yr " & FORMAT(L, "0") & "")
		displayFolder: 1 Generation
		lineageTag: 9979ceb4-b27b-58d2-af05-4d8fde5147fb

	measure 'Source Share' = DIVIDE([Generation TWh], CALCULATE([Generation TWh], ALL('Generation'[Source], 'Generation'[Source Order])))
		formatString: 0.0%
		displayFolder: 1 Generation
		lineageTag: ec369b79-6aa8-5699-9a41-0ed2220f4dbc

	measure 'Solar TWh' = CALCULATE([Generation TWh], 'Generation'[Source] = "Solar") + 0
		formatString: #,##0
		displayFolder: 1 Generation
		lineageTag: 9ec94797-1c8d-5de2-959b-9734e3966a23

	measure 'Solar Delta Text' =
